# Copy to .env and change for anything beyond local testing. Never commit .env.
# SQL Server password for docker-compose.yml: 8+ characters with upper case, lower case and a digit.
DB_PASSWORD=Change-me-1
DEMO_DATA=true
# Signs "keep me logged in" cookies. Generate one with: openssl rand -base64 32
REMEMBER_ME_KEY=change-me-to-a-long-random-value
